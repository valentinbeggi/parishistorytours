---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  kicker: string;
  title: string;
  subtitle: string;
  /** object-position override (e.g. "center 70%" to push the subject down) */
  objectPosition?: string;
  /** Google rating badge — links to the Business Profile. */
  rating?: { value: string; count: string; href: string; label: string };
  /** Short facts rendered as a separated strip (price, duration, group size). */
  facts?: string[];
  /** Direct booking CTA (usually the on-page #book anchor). */
  cta?: { label: string; href: string };
  /** Tour slug — enables the live "Next date · spots left" line. */
  slug?: string;
  nextLabel?: string;
  spotsTemplate?: string;
}

const {
  image,
  alt,
  kicker,
  title,
  subtitle,
  objectPosition,
  rating,
  facts,
  cta,
  slug,
  nextLabel,
  spotsTemplate,
} = Astro.props;
---

<section class="qtourhero">
  <Picture
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1800, 2400]}
    sizes="100vw"
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    loading="eager"
    quality={82}
    class="qtourhero__img"
    style={objectPosition ? `object-position: ${objectPosition}` : undefined}
  />
  <div class="qtourhero__scrim"></div>
  <div class="qtourhero__content">
    <p class="qtourhero__kicker">{kicker}</p>
    <h1 class="qtourhero__title">{title}</h1>
    {subtitle && <p class="qtourhero__subtitle">{subtitle}</p>}

    {(rating || (facts && facts.length > 0)) && (
      <div class="qtourhero__meta">
        {rating && (
          <a class="qtourhero__rating" href={rating.href} target="_blank" rel="noopener">
            <span aria-hidden="true">★</span> <b>{rating.value}</b> · {rating.count} {rating.label}
          </a>
        )}
        {facts && facts.map((f) => <span class="qtourhero__fact">{f}</span>)}
      </div>
    )}

    {cta && (
      <div class="qtourhero__cta-row">
        <a href={cta.href} class="qtourhero__cta" data-track="cta_tour_hero_book">{cta.label} <span aria-hidden="true">→</span></a>
        {slug && (
          <div
            class="qtourhero__next pht-next pht-next--dark"
            data-next-session={slug}
            data-next-label={nextLabel}
            data-spots-template={spotsTemplate}
            hidden
          ></div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .qtourhero {
    position: relative;
    width: 100%;
    height: min(80vh, 760px);
    overflow: hidden;
    background: var(--ink);
  }
  .qtourhero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .qtourhero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.25) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }
  .qtourhero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 48px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    color: var(--paper-3);
  }
  .qtourhero__kicker {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 20px;
  }
  .qtourhero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
    color: var(--paper-3);
  }
  .qtourhero__subtitle {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin: 20px 0 0;
    max-width: 56ch;
  }

  .qtourhero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
    margin-top: 20px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
  }
  .qtourhero__meta > * + *::before {
    content: "·";
    margin-right: 12px;
    opacity: 0.6;
  }
  .qtourhero__rating {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 1px;
    transition: border-color 120ms ease;
  }
  .qtourhero__rating:hover { border-bottom-color: #fff; }
  .qtourhero__rating b { font-weight: 600; }

  .qtourhero__cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .qtourhero__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--paper-3);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 14px 24px;
    border-radius: 2px;
    text-decoration: none;
    border: 1px solid var(--paper-3);
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }
  .qtourhero__cta:hover {
    background: var(--rouge);
    border-color: var(--rouge);
    color: #fff;
  }
  .qtourhero__next {
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .qtourhero { height: 74vh; }
    .qtourhero__content { bottom: 36px; padding: 0 20px; }
    .qtourhero__subtitle { font-size: 15px; }
    .qtourhero__meta { font-size: 13px; }
  }
</style>

<script>
  import { initNextSessions } from '../../scripts/next-session';
  initNextSessions();
</script>
