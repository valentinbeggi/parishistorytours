---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import QuietFooter from "../components/quiet/Footer.astro";
import { useTranslations } from '../i18n/utils';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import playfairWoff2 from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';

const lang = Astro.locals.lang;
const t = useTranslations(lang);

const {
  title = "Paris History Tours",
  description = "WWII walking tours in Paris: Right Bank and Left Bank routes exploring the Fall, Resistance, and Liberation.",
  ogImage = "/photos/og-default.jpg",
  ogType = "website",
  noindex = false,
  preloadImages = [] as Array<string | { srcset: string; sizes: string }>,
  theme = 'legacy' as 'legacy' | 'quiet',
  // Override the default same-path hreflang mapping when the translated page
  // lives at a different slug (blog articles). `null` means no alternate exists.
  alternates = undefined as { en?: string | null; fr?: string | null } | undefined,
} = Astro.props;

const isQuiet = theme === 'quiet';

const origin = Astro.url.origin;
const pathname = Astro.url.pathname;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`;
// Normalize to trailing-slash URLs so canonicals match the sitemap
// (prerendered pages are built as directories, i.e. /path/).
const norm = (p: string) => (p === '/' || p.endsWith('/') ? p : `${p}/`);
// Compute base path (without /fr prefix) for hreflang - works with both direct and rewritten URLs
const basePath = pathname.startsWith('/fr') ? (pathname.replace(/^\/fr/, '') || '/') : pathname;
const enPath = alternates ? alternates.en ?? null : basePath;
const frPath = alternates ? alternates.fr ?? null : (basePath === '/' ? '/fr' : `/fr${basePath}`);
const enUrl = enPath ? `${origin}${norm(enPath)}` : null;
const frUrl = frPath ? `${origin}${norm(frPath)}` : null;
const xDefaultUrl = enUrl ?? frUrl;
const canonicalUrl = (lang === 'fr' ? frUrl : enUrl) ?? `${origin}${norm(pathname)}`;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Google Analytics 4 (gtag.js) — deferred to reduce unused JS on initial
         load. Loaded directly rather than through GTM: the published container
         (GTM-K6M2KKL7) is empty (no GA4 config tag), so routing through it
         shipped ~330 KB of JS without ever starting analytics. Events are sent
         via gtag('event', …) from src/scripts/track.ts; calls made before the
         library boots queue in dataLayer and are replayed at load.
         is:inline keeps the bootstrap in the HTML itself (no bundling). -->
<script is:inline>
  // @ts-nocheck
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('js', new Date());
  // ?ga_debug=1 sur n'importe quelle page → les hits de cette visite
  // apparaissent en direct dans GA4 Admin → DebugView (diagnostic).
  var GA_DBG = /[?&]ga_debug=1/.test(location.search);
  gtag('config', 'G-26695P8H33', GA_DBG ? { debug_mode: true } : {});

  function loadAnalytics() {
    var j = document.createElement('script');
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtag/js?id=G-26695P8H33';
    document.head.appendChild(j);
  }

  // Load analytics after page is idle (3.5s delay)
  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadAnalytics, { timeout: 3500 });
  } else {
    setTimeout(loadAnalytics, 3500);
  }
</script>
    <meta charset="utf-8" />
    <!-- Fallback for some analyzers expecting http-equiv -->
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {frUrl && <link rel="alternate" hreflang="fr" href={frUrl} />}
    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
    <!-- Favicon and icons -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Paris History Tours" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Noindex for non-content pages -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://js.stripe.com" />
    <link rel="dns-prefetch" href="https://js.stripe.com" />
    <!-- Preload the fonts the active theme actually renders above the fold:
         quiet = Inter + Playfair Display (Fontsource), legacy = Montserrat -->
    {isQuiet ? (
      <>
        <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={playfairWoff2} as="font" type="font/woff2" crossorigin />
      </>
    ) : (
      <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    )}
    {preloadImages.map((img) =>
      typeof img === 'string'
        ? <link rel="preload" as="image" href={img} />
        : <link rel="preload" as="image" imagesrcset={img.srcset} imagesizes={img.sizes} />
    )}
  </head>

  <body class={isQuiet ? "antialiased" : "font-sans text-gray-900 antialiased"} data-theme={isQuiet ? "quiet" : undefined}>
    <script>
      // Site-wide conversion click tracking (WhatsApp, email, partner logos,
      // [data-track] CTAs). Pushes queue in dataLayer until GTM boots.
      import { initClickTracking } from '../scripts/track';
      initClickTracking();
    </script>
    <slot />
    {isQuiet ? <QuietFooter /> : <Footer />}
  </body>
</html>