---
import ArticlePage from '../../components/quiet/ArticlePage.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

// English articles only — French articles live under /fr/blog/ (see
// src/pages/fr/blog/[...slug].astro) so each language has a single URL.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<ArticlePage post={post} />
