---
import ArticlePage from '../../../components/quiet/ArticlePage.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

// French articles only — English articles live under /blog/ (see
// src/pages/blog/[...slug].astro) so each language has a single URL.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'fr');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<ArticlePage post={post} />
